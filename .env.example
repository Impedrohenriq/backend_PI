# Copie este arquivo para .env e ajuste os valores.
# .env nunca deve ser commitado (ja esta no .gitignore).

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=0608
PG_DATABASE=hunter_db

# --- Scraper (backend/scraping) ---
# dynamic = Playwright padrao | stealthy = sessao anti-deteccao (Camoufox)
SCRAPER_FETCHER=dynamic
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=60000
SCRAPER_MAX_PAGINAS_POR_CATEGORIA=20
SCRAPER_MIN_DELAY_SECONDS=1.0
SCRAPER_MAX_DELAY_SECONDS=2.5
SCRAPER_MAX_RETRIES=3
SCRAPER_SAVE_FAILURE_HTML=true
